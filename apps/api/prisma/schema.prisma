// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PaypalOrder {
  id              String   @id @default(cuid())
  paypalOrderId   String   @unique
  status          String
  currencyCode    String?
  amount          Decimal? @db.Decimal(18, 2)
  approvalUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  captures        PaypalCapture[]
}

model PaypalCapture {
  id              String   @id @default(cuid())
  paypalCaptureId String   @unique
  paypalOrderId   String
  status          String
  currencyCode    String?
  amount          Decimal? @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  order           PaypalOrder @relation(fields: [paypalOrderId], references: [paypalOrderId])

  @@index([paypalOrderId])
}

model PaypalWebhookEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  eventType       String
  resourceType    String?
  resourceId      String?
  summary         String?
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@index([eventType])
  @@index([resourceId])
}

model PaypalPaymentEvent {
  id              String   @id @default(cuid())
  paypalOrderId   String?
  paypalCaptureId String?
  source          String
  eventType       String
  previousStatus  String?
  newStatus       String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([paypalOrderId])
  @@index([paypalCaptureId])
  @@index([eventType])
  @@index([createdAt])
}

model Business {
  id          String     @id @default(cuid())
  name        String
  currency    String     @default("USD")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customers   Customer[]
  invoices    Invoice[]
  aiRuns AiRun[]
  memberships BusinessMembership[]
}

model Customer {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  email       String
  riskLevel   String     @default("MEDIUM")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business    Business   @relation(fields: [businessId], references: [id])

  invoices    Invoice[]

  @@index([businessId])
  @@index([email])
}

model Invoice {
  id                String     @id @default(cuid())
  businessId        String
  customerId        String

  invoiceNumber     String     @unique
  amount            Decimal    @db.Decimal(18, 2)
  currencyCode      String
  status            String

  issuedAt          DateTime
  dueAt             DateTime
  paidAt            DateTime?

  reminderCount     Int        @default(0)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  business          Business   @relation(fields: [businessId], references: [id])

  customer          Customer   @relation(fields: [customerId], references: [id])

  opportunities     RevenueOpportunity[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([dueAt])
}

model RevenueOpportunity {
  id                String    @id @default(cuid())

  invoiceId         String

  type              String
  priority          String
  reason            String

  outstandingAmount Decimal   @db.Decimal(18, 2)
  estimatedRecovery Decimal   @db.Decimal(18, 2)
  confidence        Decimal   @db.Decimal(5, 2)

  recommendedAction String

  status            String    @default("OPEN")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice           Invoice   @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, type])
  @@index([invoiceId])
  @@index([status])
  @@index([priority])
}

model AiRun {
  id                String        @id @default(cuid())
  businessId        String
  provider          String
  model             String
  status            String        @default("COMPLETED")
  invoiceCount      Int
  totalOutstanding  Decimal       @db.Decimal(18, 2)
  estimatedRecovery Decimal       @db.Decimal(18, 2)
  summary           String
  createdAt         DateTime      @default(now())

  business          Business      @relation(fields: [businessId], references: [id])
  decisions         AiDecision[]

  @@index([businessId, createdAt])
  @@index([status])
}

model AiDecision {
  id                String   @id @default(cuid())
  aiRunId            String
  invoiceId          String
  decision           String
  reason             String
  estimatedRecovery  Decimal  @db.Decimal(18, 2)
  requiresApproval   Boolean
  policyStatus       String
  policyReason       String
  createdAt          DateTime @default(now())

  run                AiRun    @relation(fields: [aiRunId], references: [id], onDelete: Cascade)

  @@unique([aiRunId, invoiceId])
  @@index([invoiceId])
  @@index([policyStatus])
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  memberships  BusinessMembership[]
}

model BusinessMembership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("MEMBER")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, role])
}